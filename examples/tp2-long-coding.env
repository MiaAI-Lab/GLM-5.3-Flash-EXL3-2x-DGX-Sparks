# Maintainer reference profile: TP=2 on 2x DGX Spark (GB10), tuned for long,
# responsive coding sessions rather than maximum context or concurrency.
#
# Use: append to an already configured .env (network, image and model settings
# come from .env.example), then restart. Not sourced automatically. Values
# below override earlier lines in the same file.
#
# Priorities: two active requests with 262,144 tokens each, fast follow-ups
# from cached history, and stable host memory. Extra requests queue. This is an
# operating choice, not the hardware maximum; four full-context agents are not
# claimed to stay fast. Every opt-in below is a tradeoff, not free speed.
#
# Image: one built from this tree (start.sh's default: it rebuilds when the
# recipe stamp drifts). GLM53_EXL3_MOE_FAST=1 fails at load on an image that
# predates the decode-pipeline patch, so do not combine SKIP_BUILD=1 with an
# older image. Numbers are single-kit TP2 measurements from the linked docs,
# taken on several image builds; re-check on other kits before relying on
# them.

# --- Capacity -----------------------------------------------------------------
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
# Small prefill chunks keep decode responsive while another request prefills
# and bound DFlash's per-request in-flight reservation. Cost: cold prefill is
# slower than at 2048 (measured ~3-14% on 8k-256k prompts) and further slower
# than the 7168 default; vLLM prints a max_num_scheduled_tokens=1024 warning at
# boot, which is expected. Never 8192 (indexer smem).
MAX_NUM_BATCHED_TOKENS=1024
# Slightly above the 0.85 default. This is 0.005 below the setting that
# crashed a head on 2026-09-06 (256k prefill at 0.87 with zero MemAvailable;
# start.sh comment on GPU_MEM_UTIL). With the options below (KDA BF16 alone
# costs ~3 GiB of idle headroom per node), the minimum sampled host
# MemAvailable over the published long-context runs was 4.64-4.73 GiB per
# node. Do not raise this further without MemAvailable in front of you.
GPU_MEM_UTIL=0.865
# Replaces .env.example's 14 GiB --kv-cache-memory-bytes line: that fixed pool
# is sized for 850k and vLLM's automatic pool is enough at 262k (12.7-12.9 GiB
# across boots here; it varies per boot). vLLM then reports "Maximum
# concurrency ... 4.15x-4.21x": that is pool ids divided by one running
# request's ids, not how many cached histories fit. Read the
# [glm53-kv-capacity-log] summary line at boot for cached-conversation
# capacity. If you raise MAX_MODEL_LEN toward 850k, restore the reservation
# (see .env.example). Keep any other EXTRA_ARGS flags you already had; this
# line replaces the whole variable. prompt-tokens-details reports cached
# tokens per response, which makes prefix reuse visible to clients and
# benchmarks.
EXTRA_ARGS="--enable-prompt-tokens-details"

# --- Default-off options enabled here -----------------------------------------
# Thin-decode routed-expert kernels: +8% to +17% layer latency in the kernel
# study; +7.7% to +14.6% decode tokens/s on the accepted cells of the
# current-main A/B/A2 (measured with GLM53_DENSE_FP8=kda). Needs an image
# built with overlay/patch_exl3_decode_pipeline.py; fails at load otherwise.
# TP=2 only. See docs/sm121-perf-paths.md.
GLM53_EXL3_MOE_FAST=1
# BF16 large-M path for KDA in_proj during prefill: cold 16k/100k TTFT
# -11.4%/-12.3%, decode unchanged. Costs ~3.3 GiB more model memory per GPU.
# See docs/kda-bf16-large-m.md.
GLM53_KDA_BF16_LARGE_M=1
# FP8 weight-only dense and KDA projections, ~11 ms less per step.
# PROVISIONAL numerics: changes outputs by FP8 rounding (KL proxy vs stock
# 0.002-0.013 nats/position, argmax agreement 94-100%; no full KLD panel).
# Leave off if bitwise-stock outputs matter.
GLM53_DENSE_FP8=dense,kda
# Compact DFlash2 cache pages: 32.78% fewer reserved cache IDs per max-length
# request (180 -> 121); a 28,672-token prefix with a 64-token tail kept its
# full prefix and repeated 90% faster. Prose decode was ~1% slower in the
# holdout and cold long prefills 1-3% slower. Reservation IDs, not VRAM.
# Requires a backend that takes the 896-token derived block (FLASH_ATTN does).
# See README "Experimental compact DFlash2 cache pages".
GLM53_DRAFT_KV_COMPACT=1
# SpinCondition reader window: +0.95% median decode and 85.3% less active
# EngineCore CPU than stock in the TP=2 sweep.
GLM53_SPINWAIT_MS=16

# --- Prefix-cache retention ---------------------------------------------------
# Sparse target checkpoints every 14,336 tokens (4 x 3,584): Mamba keeps one
# state per interval instead of one per 3,584-token segment, so the same pool
# can hold more cached history. SWA=0 keeps drafter blocks only at reachable
# boundaries and evicts draft-only blocks before target blocks.
# UNQUALIFIED PAIR. The kit only measured global/SWA 0/0: it retained four
# independent 210k histories, but a matched 128k edit at 90% went from
# 14.70 s to 112.49 s and a branch at 90% from 3.35 s to 99.89 s (zero reuse
# instead of 111,104 tokens). With 14336 the expected cost is a recompute
# back to the previous checkpoint after an edit or branch; that expectation
# has not been measured. Leave both unset for a dense grid, or qualify this
# pair on your workload first: docs/apc-retention-qualification.md and
# README "Optional sparse retention and DFlash replay".
GLM53_APC_RETENTION_INTERVAL=14336
GLM53_APC_RETENTION_INTERVAL_SWA=0

# --- Kept at defaults (stated for clarity) ------------------------------------
# DFlash2 at k=7 with adaptive-k off; E3 grouped prefill and fair mixed-prefill
# scheduling are already on by default.
DFLASH_TOKENS=7
GLM53_ADAPTIVE_K=off
LOAD_FORMAT=instanttensor
