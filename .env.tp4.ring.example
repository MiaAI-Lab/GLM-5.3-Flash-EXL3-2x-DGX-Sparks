# Copy to .env.tp4. Never commit your filled-in configuration.
# Management LAN: all four nodes must reach each other for vLLM TCP bootstrap.
HEAD_IP=CHANGE_ME_HEAD
WORKER_IP=CHANGE_ME_WORKER1
WORKER2_IP=CHANGE_ME_WORKER2
WORKER3_IP=CHANGE_ME_WORKER3
WORKER_USER=incoxe
WORKER2_USER=incoxe
WORKER3_USER=incoxe
# NCCL_SOCKET_IFNAME is the all-rank reachable MANAGEMENT interface here.
# Exact interface selector; inspect `ip -br addr` on each node.
HEAD_CX7_IF='=CHANGE_ME_MGMT_INTERFACE'
WORKER_CX7_IF='=CHANGE_ME_MGMT_INTERFACE'
WORKER2_CX7_IF='=CHANGE_ME_MGMT_INTERFACE'
WORKER3_CX7_IF='=CHANGE_ME_MGMT_INTERFACE'
# RDMA payload stays on the TWO cable-facing CX7 ports, not management LAN.
# Replace HCA names from `ibdev2netdev`; do not infer them from Linux NIC names.
HEAD_CX7_IB='=CHANGE_ME_HCA0:1,CHANGE_ME_HCA1:1'
WORKER_CX7_IB='=CHANGE_ME_HCA0:1,CHANGE_ME_HCA1:1'
WORKER2_CX7_IB='=CHANGE_ME_HCA0:1,CHANGE_ME_HCA1:1'
WORKER3_CX7_IB='=CHANGE_ME_HCA0:1,CHANGE_ME_HCA1:1'
HEAD_GID=3
WORKER_GID=3
WORKER2_GID=3
WORKER3_GID=3
NCCL_SWITCHLESS_RING_ONLY=1
USE_HOST_NCCL=1
NCCL_HOST_DIR=$HOME/nccl-2.30.7
# Worker defaults: /home/<worker-user>/nccl-2.30.7; override if needed.
NCCL_SO_NAME=libnccl.so.2.30.7
NCCL_IB_SUBNET_PREFIX_LEN=24
NCCL_CROSS_NIC=1
NCCL_NCHANNELS=4
NCCL_DEBUG=INFO
IMAGE=ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3-instanttensor
LOAD_FORMAT=instanttensor
# Images must already be loaded on all ranks. Avoid mutable-tag refresh/build.
SKIP_PULL=1
SKIP_BUILD=1
SKIP_SHIP=1
TP=4
NNODES=4
PORT=8888
MASTER_PORT=29521
CONTAINER_HEAD=glm53-exl3-tp4-head
CONTAINER_WORKER=glm53-exl3-tp4-w1
CONTAINER_WORKER2=glm53-exl3-tp4-w2
CONTAINER_WORKER3=glm53-exl3-tp4-w3
# Commissioning baseline (DFlash off, 128k, 4 seqs). Measured production on a
# 4× 200 GbE ring was 256k / 8 seqs / DFlash k=3 / draft TP=4 / NCCL_NCHANNELS=8
# / GMU 0.75 — see docs/tp4-switchless-ring-results.md. Do not jump there first.
MAX_MODEL_LEN=131072
GPU_MEM_UTIL=0.75
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=2048
SPEC_METHOD=none
DFLASH_DRAFT_TP=4
DFLASH_TOKENS=3
GLM53_MIXED_PREFILL_CHUNK=fair
GLM53_FAIR_PREFILL_CHUNK=256
GLM53_FAIR_PREFILL_SHARE=0.30
GLM53_FAIR_PREFILL_MAX_INTERVAL_MS=2000
GLM53_FAIR_PREFILL_MAX_STEP_MS=2000
GLM53_FAIR_PREFILL_MAX_CHUNKS=1
