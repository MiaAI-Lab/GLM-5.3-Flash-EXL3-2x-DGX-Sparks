.env
.env.tp4
.env.tp3
.glm53-exl3-*.inner.sh
logs/
tool-eval-bench/
# Transplant dumps (~2.7 GiB) stay local; fetch with ablit/fetch_transplant.py
ablit/*
!ablit/LAYER_MAP.json
!ablit/refusal_direction_glm53_dealign_late.pt
!ablit/refusal_direction_glm53_bf_oproj.pt
!ablit/fetch_transplant.py
__pycache__/
*.py[cod]
.pytest_cache/


# bench artifacts (prefix-cache runs write here)
results/

# Cooperative MoE native artifacts are staged, not committed.
extensions/cooperative_moe/*.so

# Display-KV native artifact is built by the launcher inside the serving image.
overlay/display_kv/*.so
overlay/display_kv/probe_display_kv
overlay/display_kv/bw_pinned
